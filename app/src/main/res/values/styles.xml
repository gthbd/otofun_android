        <!--<item name="searchIcon">@drawable/ic_search_gray_24dp</item>-->
        <!--<item name="closeIcon">@drawable/ic_clear_gray_24dp</item>-->
    <!--</style>-->

    <style name="RadioButtonStyle" parent="Material.Drawable.RadioButton">
        <item name="rbd_strokeSize">1dp</item>
        <item name="rbd_strokeColor">@color/colorPrimary</item>
        <item name="fontPath">fonts/Roboto-Regular.ttf</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14dp</item>
    </style>
</resources>
