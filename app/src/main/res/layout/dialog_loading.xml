<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="horizontal">

    <com.rey.material.widget.ProgressView
        android:id="@+id/dialog_loading_progress"
        android:layout_width="@dimen/LOADING_WIDTH"
        android:layout_height="@dimen/LOADING_HEIGHT"
        android:layout_gravity="center"
        app:pv_autostart="true"
        app:pv_circular="true"
        app:pv_progressMode="indeterminate"
        app:pv_progressStyle="@style/ColorsCircularProgressDrawableStyle" />

    <TextView
        android:id="@+id/dialog_loading_textView"
        style="@style/CaptionTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="Loading..."
        android:textColor="@color/text_normal"
        android:visibility="gone" />

</LinearLayout>