<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/drawer_header_background"/>


        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/drawer_header_circleView"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginLeft="10dp"
            android:layout_centerVertical="true"
            android:src="@drawable/avatar_default_large"
            app:border_color="@color/avatar_border"
            app:border_width="0dp" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf ="@id/drawer_header_circleView"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/drawer_header_name"
                style="@style/TitleTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_normal"
                android:text="XXXXXXXXXXX"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/drawer_header_money"
                style="@style/TitleTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_normal"
                android:text="XXXXXXXXXXX"
                android:textSize="18dp" />

        </LinearLayout>

        <!--<View-->
            <!--android:id="@+id/view"-->
            <!--android:layout_width="0dp"-->
            <!--android:layout_height="0dp"-->
            <!--android:layout_weight="1" />-->

        <TextView
            android:id="@+id/drawer_header_arrow"
            style="@style/IconTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="20dp"
            android:background="@null"
            android:gravity="center"
            android:text="@string/ion_ios_arrow_right"
            android:textAppearance="?android:textAppearanceLarge"
            android:textSize="24dp"
            android:textColor="@color/text_normal"/>


</RelativeLayout>