<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/DIALOG_WIDTH_MAP"
    android:layout_height="@dimen/DIALOG_HEIGHT_MAP"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_bright_white"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/dialog_location_map_title"
            style="@style/Body2TextStyle"
            android:layout_width="@dimen/DIALOG_WIDTH_MAP"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="" />

        <TextView
            android:id="@+id/dialog_location_map_content"
            style="@style/Body1TextStyle"
            android:layout_width="@dimen/DIALOG_WIDTH_MAP"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dialog_location_map_title"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:lines="2" />

        <LinearLayout
            android:id="@+id/dialog_location_map_pane"
            android:layout_width="@dimen/DIALOG_WIDTH_MAP"
            android:layout_height="@dimen/EDITTEXT_HEIGHT"
            android:layout_below="@+id/dialog_location_map_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <Button
                android:id="@+id/dialog_location_map_cancel"
                style="@style/FlatWaveButtonRippleStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:text="Bỏ qua"
                android:textAllCaps="true"
                android:textColor="@color/text_dark" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="4dp"
                android:background="#c9c9c9" />

            <Button
                android:id="@+id/dialog_location_map_ok"
                style="@style/FlatWaveButtonRippleStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:text="Đồng ý"
                android:textAllCaps="true"
                android:textColor="@color/text_dark" />

        </LinearLayout>

    </RelativeLayout>

    <TextView
        style="@style/IconTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dialog_location_map_pane"
        android:background="@null"
        android:layout_marginTop="-20dp"
        android:gravity="center_horizontal"
        android:text="@string/ion_android_arrow_dropdown"
        android:textAppearance="?android:textAppearanceLarge"
        android:textColor="@color/background_bright_white"
        android:textSize="50dp" />

</LinearLayout>
