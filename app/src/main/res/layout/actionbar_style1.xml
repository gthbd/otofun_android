<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:custom="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_main_dark"
                >



    <com.rey.material.widget.Button
        android:id="@+id/actionbar_style1_back_button"
        style="@style/IconButtonStyle"
        android:layout_width="38dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginLeft="4dp"
        android:layout_alignParentLeft="true"
        android:text="@string/ion_chevron_left"
        />

    <TextView
        android:id="@+id/actionbar_style1_title_textView"
        style="@style/TitleTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_bright"
        android:text="..."/>


    <LinearLayout
        android:id="@+id/actionbar_right_tool"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/actionbar_style1_title_textView"
        android:layout_alignParentRight="true"
        android:orientation="horizontal">



        <LinearLayout
            android:id="@+id/actionbar_right_tool_threads"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:orientation="horizontal"
            android:visibility="gone">


            <!--<com.rey.material.widget.Button-->
                <!--android:id="@+id/actionbar_right_tool_threads_filter_button"-->
                <!--style="@style/RaiseWaveColorButtonRippleStyle"-->
                <!--android:layout_width="140dp"-->
                <!--android:layout_height="@dimen/BUTTON_HEIGHT"-->
                <!--android:layout_marginTop="22dp"-->
                <!--android:layout_marginBottom="10dp"-->
                <!--android:layout_gravity="center_horizontal"-->
                <!--android:text="Tất cả"-->
                <!--android:textColor="@color/text_bright"/>-->

        </LinearLayout>


        <LinearLayout
            android:id="@+id/actionbar_right_tool_webview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.github.rahatarmanahmed.cpv.CircularProgressView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/actionbar_right_tool_webview_busy_progress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                app:cpv_startAngle="-90"
                app:cpv_indeterminate="true"
                app:cpv_color="@color/background_bright_white"
                />

            <com.rey.material.widget.Button
                android:id="@+id/actionbar_right_tool_webview_star_button"
                style="@style/IconButtonStyle"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="@string/ion_star"
                android:textColor="@color/text_blur"
                android:textSize="26dp"
                />

            <com.rey.material.widget.Button
                android:id="@+id/actionbar_right_tool_webview_home_button"
                style="@style/IconButtonStyle"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="@string/ion_ios_home"
                android:textColor="@color/background_main"
                android:textSize="26dp"
                />

            <com.rey.material.widget.Button
                android:id="@+id/actionbar_right_tool_webview_reload_button"
                style="@style/IconButtonStyle"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="@string/ion_refresh"
                android:textColor="@color/background_main"
                android:textSize="26dp"
                />


            <com.rey.material.widget.Button
                android:id="@+id/actionbar_right_tool_webview_back_button"
                style="@style/IconButtonStyle"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="@string/ion_reply"
                android:textColor="@color/text_blur"
                android:textSize="30dp"
                />

            <com.rey.material.widget.Button
                android:id="@+id/actionbar_right_tool_webview_forward_button"
                style="@style/IconButtonStyle"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="@string/ion_forward"
                android:textColor="@color/text_blur"
                android:textSize="30dp"
                />


        </LinearLayout>
    </LinearLayout>
</RelativeLayout>