<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/dialog_background"
              android:gravity="center_horizontal"
              android:orientation="vertical">

    <TextView
        android:id="@+id/dialog_choice_list_title_textView"
        style="@style/Body2TextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="title"
        android:textColor="@color/text_dark"
        android:textStyle="bold"/>

    <ListView
        android:id="@+id/dialog_choice_list_listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@null"
        android:overScrollMode="never"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:scrollbarStyle="outsideOverlay"/>

    <LinearLayout
        android:id="@+id/dialog_choice_list_buttons_pane"
        android:layout_width="match_parent"
        android:layout_height="@dimen/BUTTON_HEIGHT"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/DIVIDER_HEIGHT"
            android:background="@color/line_normal"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dialog_choice_list_negative_button"
                style="@style/FlatWaveButtonRippleStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/text_dark"/>

            <View
                android:layout_width="@dimen/DIVIDER_HEIGHT"
                android:layout_height="match_parent"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="4dp"
                android:background="@color/line_normal"/>

            <Button
                android:id="@+id/dialog_choice_list_positive_button"
                style="@style/FlatWaveButtonRippleStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/text_dark"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>